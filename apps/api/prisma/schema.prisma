generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique // no spaces; also the public profile url: /<name>
  email     String   @unique
  password  String
  profile   Profile?
  songs     Song[]
  likes     Like[]
  following Follow[] @relation("following")
  followers Follow[] @relation("followers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// 1:1 with users. Created on the first edit, so a user may not have one yet
model Profile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  avatarKey   String? // S3 object key: avatars/<userId>/<uuid>.<ext>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// The row is saved when the upload url is handed out, before the file reaches S3
model Song {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  genres      String[] @default([]) // from the fixed list in upload-song-file.dto.ts
  // songs/<userId>/<id>/<music|image|video>. Each key is saved before its file reaches S3
  musicKey    String   @unique
  imageKey    String?
  videoKey    String?
  likes       Like[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("songs")
}

// One row per user per liked song
model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([songId])
  @@map("likes")
}

// follower follows following
model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}
