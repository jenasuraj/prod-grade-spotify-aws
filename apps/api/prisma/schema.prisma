generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique // no spaces; also the public profile url: /<name>
  email     String   @unique
  password  String
  profile   Profile?
  songs     Song[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// 1:1 with users. Created on the first edit, so a user may not have one yet
model Profile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  avatarKey   String? // S3 object key: avatars/<userId>/<uuid>.<ext>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// The row is saved when the upload url is handed out, before the file reaches S3
model Song {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  genres      String[] @default([]) // from the fixed list in upload-song-file.dto.ts
  // songs/<userId>/<id>/<music|image|video>. Each key is saved before its file reaches S3
  musicKey    String   @unique
  imageKey    String?
  videoKey    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("songs")
}
