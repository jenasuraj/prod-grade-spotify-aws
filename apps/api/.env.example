PORT=3000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Local (docker compose). In the cloud, replace only these two lines with your provider's strings, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# REDIS_URL="rediss://default:pass@host:6379"   (rediss:// = TLS, which most managed Redis requires)
DATABASE_URL="postgresql://spotify:spotify@localhost:5432/spotify?schema=public"
REDIS_URL="redis://localhost:6380"

# Auth: use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# OTP emails via a Gmail app password. Left empty in development, the code is printed to the API log instead
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Avatar uploads (private bucket; images are served through 1-hour signed urls)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
