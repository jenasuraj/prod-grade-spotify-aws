PORT=3000
WEB_ORIGIN=http://localhost:5173

# Local (docker compose). In the cloud, replace only these two lines with your provider's strings, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# REDIS_URL="rediss://default:pass@host:6379"   (rediss:// = TLS, which most managed Redis requires)
DATABASE_URL="postgresql://spotify:spotify@localhost:5432/spotify?schema=public"
REDIS_URL="redis://localhost:6380"
